# Local development: run from the repository root with python -m gateway.main.
# Precedence: process environment > gateway/.env > src/charts_agent/.env.
# No Azure tokens, client secrets, or model API keys belong in this file.
GATEWAY_MODE=local
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8190
LOCAL_AGENT_URL=http://127.0.0.1:8188
CHARTS_DEV_MODE=true

# Optional: invoke an already-deployed hosted agent from this gateway.
# Change GATEWAY_MODE above to foundry and provide real values:
# FOUNDRY_PROJECT_ENDPOINT=
# FOUNDRY_AGENT_NAME=
# FOUNDRY_AGENT_VERSION=
# DefaultAzureCredential supplies server-side Azure authentication.

# External gateway hosting requires its own service and HTTPS ingress.
# It is NOT an arbitrary web route on the Foundry hosted-agent endpoint.
# Change CHARTS_DEV_MODE above to false before binding outside loopback.
# GATEWAY_HOST=0.0.0.0
# GATEWAY_PUBLIC_ORIGIN=
# ENTRA_TENANT_ID=
# ENTRA_AUDIENCE=
# ENTRA_REQUIRED_SCOPES=Charts.Read

# Optional exact HTTPS MCP host/widget origins, separated by spaces.
# These affect MCP CORS only, never REST origin validation. No wildcards.
# GATEWAY_MCP_ORIGINS=
