FOUNDRY_PROJECT_ENDPOINT=https://YOUR-ACCOUNT.services.ai.azure.com/api/projects/YOUR-PROJECT
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
CHARTS_DEV_MODE=true
ARTIFACT_MODE=local
ARTIFACT_BASE_URL=http://localhost:8088/artifacts
ARTIFACT_DIRECTORY=artifacts
# For Foundry hosting, use an existing private container and managed identity:
# CHARTS_DEV_MODE=false
# ARTIFACT_MODE=blob
# AZURE_STORAGE_ACCOUNT_URL=https://YOUR-ACCOUNT.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=charts
# ARTIFACT_TTL_MINUTES=60
# Optional separate mock API (defaults to in-process HTTP ASGI transport):
# MOCK_API_URL=http://127.0.0.1:8091
# Activity delivery defaults; hosted overrides must also be forwarded in azure.yaml:
# ACTIVITY_PROACTIVE_AFTER_SECONDS=35
# ACTIVITY_KEEPALIVE_SECONDS=15
# ACTIVITY_TURN_TIMEOUT_SECONDS=100
